# Leer lassen, wenn das Frontend hinter demselben nginx wie die API laeuft (Standard).
# Nur setzen, wenn die API auf einem anderen Origin liegt, z.B. https://api.example.com
VITE_API_BASE=

# Betreiberangaben fuer Impressum/Datenschutz/Nutzungsbedingungen (Pflicht fuer den
# oeffentlichen Betrieb; ohne Werte zeigt die App Platzhalter). Die Texte in
# src/components/Rechtliches.jsx sind nur eine Vorlage: an den eigenen Betrieb anpassen
# (Hosting, E-Mail-Versand, KI-Anbieter) und rechtlich pruefen lassen!
VITE_IMPRESSUM_NAME=
VITE_IMPRESSUM_STRASSE=
VITE_IMPRESSUM_ORT=
VITE_IMPRESSUM_LAND=Deutschland
VITE_IMPRESSUM_EMAIL=
# Optional: Telefon (wird nur angezeigt, wenn gesetzt)
VITE_IMPRESSUM_TELEFON=
# Optional: Angaben zur Umsatzsteuer (Abschnitt erscheint nur, wenn gesetzt)
VITE_IMPRESSUM_UST=
# Optional: Stand der Rechtstexte, z. B. "Oktober 2026"
VITE_RECHTSTEXTE_STAND=
# Auf 1 setzen, wenn die Texte angepasst und geprueft sind: blendet den sichtbaren
# Vorlagen-Hinweis aus (nur wirksam, wenn NAME/STRASSE/ORT gesetzt sind).
VITE_RECHTSTEXTE_GEPRUEFT=
# Oeffentliche Web-Adresse (fuer die native App-Huelle / Links)
VITE_WEB_URL=
