# Beispielkonfiguration. Kopieren nach .env und Werte setzen: cp .env.example .env
# .env niemals committen.

# --- Datenbank (Pflicht) ---
# docker compose verlangt POSTGRES_PASSWORD (kein Default).
POSTGRES_DB=koch
POSTGRES_USER=koch
POSTGRES_PASSWORD=
# Fuer den Compose-Betrieb: Host "db" = Postgres-Service aus docker-compose.yml
DATABASE_URL=postgresql://koch:<POSTGRES_PASSWORD>@db:5432/koch
DB_SCHEMA=koch

# --- App ---
PORT=8093
# Oeffentliche Basis-URL der Web-App (Links in E-Mails)
APP_BASE_URL=http://localhost:8096
WEB_BASE_URL=
CORS_ORIGINS=*
API_TOKEN=
# Token, mit dem der allererste Signup Plattform-Admin wird (leer = niemand)
ADMIN_BOOTSTRAP_TOKEN=
TRUSTED_PROXY_HOPS=1
MCP_ENABLED=0

# --- KI: Google Vertex AI (Pflicht fuer KI-Funktionen, kein Default) ---
# Auth ueber Application Default Credentials (Service-Account bzw.
# `gcloud auth application-default login`).
GCP_PROJECT=
VERTEX_LOCATION=global
VERTEX_BASE_URL=
VERTEX_PREDICT_BASE=
CHAT_MODEL=
IMAGE_MODEL=
IMAGE_MODEL_STANDARD=
IMAGE_STYLE=
ANGEBOTE_STUFE=schnell
KI_PERSONENNAMEN=0
SPRACHEINGABE_AKTIV=0

# --- E-Mail (optional, Resend) ---
RESEND_API_KEY=
MAIL_FROM=
# Betreiberangaben im Mail-Footer (leer = nicht angezeigt)
OPERATOR_NAME=
SUPPORT_EMAIL=

# --- Sonstiges (optional) ---
# Oeffentlicher ICS-Speiseplan-Feed (leer = aus)
KALENDER_TOKEN=
SENTRY_DSN=
SENTRY_ENV=
