# Beispielkonfiguration. Kopieren nach .env und Werte setzen: cp .env.example .env
# .env niemals committen.

# --- Datenbank (Pflicht) ---
# docker compose verlangt POSTGRES_PASSWORD (kein Default).
POSTGRES_DB=koch
POSTGRES_USER=koch
POSTGRES_PASSWORD=
# Die App verbindet sich als koch_app (kein Superuser): Superuser umgehen Row Level
# Security, dann waeren die Haushalte nicht getrennt. Rolle legt db/02-app-rolle.sh an.
APP_DB_PASSWORD=
# Fuer den Compose-Betrieb: Host "db" = Postgres-Service aus docker-compose.yml
DATABASE_URL=postgresql://koch_app:<APP_DB_PASSWORD>@db:5432/koch
DB_SCHEMA=koch

# --- App ---
PORT=8093
# Oeffentliche Basis-URL der Web-App (Links in E-Mails)
APP_BASE_URL=http://localhost:8096
WEB_BASE_URL=
CORS_ORIGINS=*
API_TOKEN=
# Token, mit dem der allererste Signup Plattform-Admin wird (leer = niemand)
ADMIN_BOOTSTRAP_TOKEN=
TRUSTED_PROXY_HOPS=1
# --- MCP-Connector fuer Claude (OAuth 2.1), siehe docs/mcp-connector.md ---
MCP_ENABLED=1
# Oeffentliche HTTPS-Adresse, unter der /mcp, /authorize, /token und /.well-known/*
# erreichbar sind. Leer = APP_BASE_URL.
PUBLIC_URL=
# Zusaetzlich erlaubte Redirect-URIs anderer OAuth-Clients (kommagetrennt, exakt)
OAUTH_REDIRECT_URIS=
OAUTH_REDIRECT_FREI=0
OAUTH_ACCESS_TTL_S=3600
OAUTH_REFRESH_TTL_TAGE=30

# --- KI (optional, eigener Anbieter / eigener Schluessel) ---
# Ohne KI_BASE_URL + KI_MODEL_DEFAULT ist die KI aus; die App funktioniert ohne KI-Knoepfe.
# OpenAI-kompatible Chat-Completions-API, z. B.:
#   OpenAI:      KI_BASE_URL=https://api.openai.com/v1        KI_MODEL_DEFAULT=gpt-4o-mini
#   OpenRouter:  KI_BASE_URL=https://openrouter.ai/api/v1     KI_MODEL_DEFAULT=<anbieter/modell>
#   Ollama:      KI_BASE_URL=http://ollama:11434/v1           KI_MODEL_DEFAULT=<lokales Modell>
#   LiteLLM:     KI_BASE_URL=http://litellm:4000/v1           KI_MODEL_DEFAULT=<Alias>
KI_BASE_URL=
KI_API_KEY=
KI_MODEL_DEFAULT=
# Modell fuer Bildeingaben (Fotos, Screenshots, PDF-Seiten). Leer = KI_MODEL_DEFAULT,
# "aus" = Modell versteht keine Bilder (Foto-Funktionen werden ausgeblendet).
KI_MODEL_VISION=
# Modell fuer den Prospekt-Import (ein Aufruf je Seite). Leer = Vision-Modell.
KI_MODEL_FLYER=
KI_TIMEOUT_S=120
# Bildgenerierung (optional, OpenAI-Images-kompatibel, z. B. gpt-image-1).
# URL/Schluessel leer = wie oben.
KI_IMAGE_BASE_URL=
KI_IMAGE_API_KEY=
KI_IMAGE_MODEL=
KI_IMAGE_SIZE=1024x1024
KI_IMAGE_STYLE=
# Spracheingabe (optional, OpenAI-kompatible Transkription, z. B. whisper-1).
KI_TRANSCRIBE_BASE_URL=
KI_TRANSCRIBE_API_KEY=
KI_TRANSCRIBE_MODEL=
# Online-Angebotssuche (optional, experimentell, Gemini-API mit Google-Suche).
KI_WEBSUCHE_GEMINI_API_KEY=
KI_WEBSUCHE_MODEL=
# Klarnamen der Haushaltsmitglieder an die KI geben (Standard: nein, Pseudonyme)
KI_PERSONENNAMEN=0

# --- E-Mail (optional, Resend) ---
RESEND_API_KEY=
MAIL_FROM=
# Betreiberangaben im Mail-Footer (leer = nicht angezeigt)
OPERATOR_NAME=
SUPPORT_EMAIL=

# --- Sonstiges (optional) ---
# Oeffentlicher ICS-Speiseplan-Feed (leer = aus)
KALENDER_TOKEN=
SENTRY_DSN=
SENTRY_ENV=
